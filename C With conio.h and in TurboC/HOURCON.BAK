#include<stdio.h>
#include<conio.h>
void main()
{       int sec,hour,min;
	int year,mon,day;
	clrscr();
		printf("Enter the no. of Seconds :");
		scanf("%d",&sec);

		hour = sec / 3600;
		sec = sec % 3600;
		min = sec / 60;
		sec = sec % 60;

		printf("\n%d : %d : %d",hour,min,sec);

		printf("\nEnter the no. of days :");
		scanf("%d",&day);

		year = day  / 365;
		day = day  % 365;
		mon = day  / 30;
		day = day % 30;

		printf("%d : %d : %d",year,mon,day);



	getch();
}